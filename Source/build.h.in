#pragma once

#define QUARTZ_NAME                     "Quartz Engine"

#define QUARTZ_BUILD_DATE               "${QUARTZ_BUILD_DATE}"
#define QUARTZ_BUILD_ID                 "${QUARTZ_BUILD_ID}"
#define QUARTZ_BUILD_TYPE               "${CMAKE_BUILD_TYPE}"

#define QUARTZ_BUILD_VERSION_MAJOR      "${PROJECT_VERSION_MAJOR}"
#define QUARTZ_BUILD_VERSION_MINOR      "${PROJECT_VERSION_MINOR}"
#define QUARTZ_BUILD_VERSION_PATCH      "${PROJECT_VERSION_PATCH}"
#define QUARTZ_BUILD_VERSION            "${PROJECT_VERSION}"
#define QUARTZ_BUILD_FULL               QUARTZ_NAME " " QUARTZ_BUILD_VERSION

#define QUARTZ_BUILD_COMPILER           "${CMAKE_CXX_COMPILER}"
#define QUARTZ_BUILD_COMPILER_VERSION   "${CMAKE_CXX_COMPILER_VERSION}"
#define QUARTZ_BUILD_COMPILER_FULL      QUARTZ_BUILD_COMPILER " " QUARTZ_BUILD_COMPILER_VERSION

#define QUARTZ_BUILD_OS_NAME            "${CMAKE_SYSTEM_NAME}"
#define QUARTZ_BUILD_OS_VERSION         "${CMAKE_SYSTEM_VERSION}"
#define QUARTZ_BUILD_OS_FULL            QUARTZ_BUILD_OS_NAME " " QUARTZ_BUILD_OS_VERSION

#define QUARTZ_BUILD_DETAILED           QUARTZ_BUILD_FULL "." QUARTZ_BUILD_ID "-" QUARTZ_BUILD_TYPE
#define QUARTZ_BUILD_EXTRA_DETAILED     QUARTZ_BUILD_DETAILED " " QUARTZ_BUILD_OS_FULL " " QUARTZ_BUILD_COMPILER_FULL

#define QUARTZ_BUILD_IS_WINDOWS         "${WIN32}"
#define QUARTZ_BUILS_IS_LINUX           "${LINUX}"
